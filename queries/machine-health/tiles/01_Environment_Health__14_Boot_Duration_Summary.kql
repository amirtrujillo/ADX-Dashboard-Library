// Dashboard: Machine Health
// Version: 0.4.0
// Page: Environment Health
// Tile: Boot Duration Summary
// Query ID: 5a6430f4-e746-45db-acc0-2baac1f48a18

// KQL-00105 — Boot duration summary
let InventoryLookback = totimespan(_inventoryLookback);
let LatestInventory =
    System_MachineInventory
    | where Timestamp between (
        _endTime - InventoryLookback .. _endTime
    )
    | summarize arg_max(
        Timestamp,
        OsPlatform,
        OsName,
        OsVersion,
        HwManufacturer,
        HwModel,
        HwIsVirtualMachine,
        RAMSizeGB,
        CPUCoresLogical
    ) by Host
    | extend HardwareModel = trim(
        " ",
        strcat(HwManufacturer, " ", HwModel)
    )
    | extend HardwareModel = iff(
        isempty(HardwareModel),
        "Unknown",
        HardwareModel
    )
    | where Host in (_host) or isempty(_host)
    | where OsPlatform in (_osPlatform) or isempty(_osPlatform)
    | where OsName in (_osName) or isempty(_osName)
    | where OsVersion in (_osVersion) or isempty(_osVersion)
    | where HardwareModel in (_hardwareModel)
        or isempty(_hardwareModel);
OnOffTransition_BootDetail2
| where Timestamp between (_startTime .. _endTime)
| join kind=inner (
    LatestInventory
    | project
        Host,
        OsPlatform,
        OsName,
        OsVersion,
        HardwareModel,
        HwIsVirtualMachine,
        RAMSizeGB,
        CPUCoresLogical
) on Host
| summarize
    AverageBootSeconds = round(avg(TotalBootTimeMs) / 1000.0, 1),
    AveragePostBootSeconds = round(avg(PostBootTimeMs) / 1000.0, 1),
    AverageMainPathSeconds = round(avg(MainPathBootTimeMs) / 1000.0, 1),
    AverageComputerStartupSeconds = round(
        avg(ComputerStartupMs) / 1000.0,
        1
    ),
    BootEvents = count(),
    Hosts = dcount(Host)