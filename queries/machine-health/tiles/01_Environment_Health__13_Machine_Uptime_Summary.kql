// Dashboard: Machine Health
// Version: 0.4.0
// Page: Environment Health
// Tile: Machine Uptime Summary
// Query ID: 67b18efa-f476-4f3e-831f-aae6f6c38e43

// KQL-00370 — Machine uptime summary
let InventoryLookback = totimespan(_inventoryLookback);
let LatestInventory =
    System_MachineInventory
    | where Timestamp between (
        _endTime - InventoryLookback .. _endTime
    )
    | summarize arg_max(
        Timestamp,
        OsPlatform,
        OsName,
        OsVersion,
        HwManufacturer,
        HwModel,
        HwIsVirtualMachine,
        RAMSizeGB,
        CPUCoresLogical
    ) by Host
    | extend HardwareModel = trim(
        " ",
        strcat(HwManufacturer, " ", HwModel)
    )
    | extend HardwareModel = iff(
        isempty(HardwareModel),
        "Unknown",
        HardwareModel
    )
    | where Host in (_host) or isempty(_host)
    | where OsPlatform in (_osPlatform) or isempty(_osPlatform)
    | where OsName in (_osName) or isempty(_osName)
    | where OsVersion in (_osVersion) or isempty(_osVersion)
    | where HardwareModel in (_hardwareModel)
        or isempty(_hardwareModel);
let SessionZero =
    Session_SessionDetail
    | where Timestamp between (_startTime .. _endTime)
    | where SessionID == 0
    | summarize arg_max(Timestamp, SessionLogonTime) by Host
    | extend BootTime = coalesce(
        todatetime(SessionLogonTime),
        Timestamp
    )
    | project Host, BootTime;
SessionZero
| join kind=inner (
    LatestInventory
    | project Host, HardwareModel
) on Host
| extend UptimeDays = round(
    todouble(
        datetime_diff(
            "second",
            _endTime,
            BootTime
        )
    ) / 86400.0,
    2
)
| summarize
    Hosts = dcount(Host),
    HardwareModels = dcount(HardwareModel),
    AverageUptimeDays = round(avg(UptimeDays), 1),
    MedianUptimeDays = round(percentile(UptimeDays, 50), 1),
    MaximumUptimeDays = round(max(UptimeDays), 1)