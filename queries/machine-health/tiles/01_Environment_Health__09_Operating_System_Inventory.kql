// Dashboard: Machine Health
// Version: 0.4.0
// Page: Environment Health
// Tile: Operating System Inventory
// Query ID: 75b93071-6d35-47ff-8921-d7b8fffad90f

// KQL-00303 — Operating-system inventory
let InventoryLookback = totimespan(_inventoryLookback);
let LatestInventory =
    System_MachineInventory
    | where Timestamp between (
        _endTime - InventoryLookback .. _endTime
    )
    | summarize arg_max(
        Timestamp,
        OsPlatform,
        OsName,
        OsVersion,
        HwManufacturer,
        HwModel,
        HwIsVirtualMachine,
        RAMSizeGB,
        CPUCoresLogical
    ) by Host
    | extend HardwareModel = trim(
        " ",
        strcat(HwManufacturer, " ", HwModel)
    )
    | extend HardwareModel = iff(
        isempty(HardwareModel),
        "Unknown",
        HardwareModel
    )
    | where Host in (_host) or isempty(_host)
    | where OsPlatform in (_osPlatform) or isempty(_osPlatform)
    | where OsName in (_osName) or isempty(_osName)
    | where OsVersion in (_osVersion) or isempty(_osVersion)
    | where HardwareModel in (_hardwareModel)
        or isempty(_hardwareModel);
LatestInventory
| extend OperatingSystem = case(
    isnotempty(OsName) and isnotempty(OsVersion),
        strcat(OsName, " ", OsVersion),
    isnotempty(OsName), OsName,
    isnotempty(OsPlatform), OsPlatform,
    "Unknown"
)
| summarize Machines = dcount(Host) by OperatingSystem
| top 15 by Machines desc