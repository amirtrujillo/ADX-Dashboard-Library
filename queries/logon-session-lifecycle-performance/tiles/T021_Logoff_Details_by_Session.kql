// DASH-005 — Logoff Details by Session
// Supplemental lifecycle query from reference SPL-00576.
let StartTime=_startTime;
let EndTime=_endTime;
let UserFilter=tolower(tostring(_user));
let HostFilter=tostring(_host);
let SessionFilter=tostring(_session);
Logoff_LogoffDetail
| where Timestamp between (StartTime .. EndTime)
| extend NormalizedUser=tolower(User), EffectiveSessionKey=iff(isnotempty(tostring(SessionGUID)),tostring(SessionGUID),strcat(Host,"|",tostring(SessionID)))
| where isempty(UserFilter) or NormalizedUser =~ UserFilter
| where isempty(HostFilter) or Host =~ HostFilter
| where isempty(SessionFilter) or EffectiveSessionKey == SessionFilter
| where isnotempty(SessionLogoffTime)
| summarize
    arg_max(Timestamp, User, Host, SessionLogoffTime),
    TotalLogoffTimeMs = sum(TotalLogoffTimeMs),
    ProfileUnloadTimeMs = sum(ProfileUnloadTimeMs2),
    GroupPolicyLogoffScriptTimeMs = sum(GroupPolicyLogoffScriptTimeMs)
    by SessionGUID
| project
    SessionGUID,
    User,
    Host,
    LogoffTime = SessionLogoffTime,
    TotalDurationSeconds = round(toreal(TotalLogoffTimeMs) / 1000.0, 2),
    ProfileUnloadSeconds = round(toreal(ProfileUnloadTimeMs) / 1000.0, 2),
    GPLogoffScriptSeconds = round(toreal(GroupPolicyLogoffScriptTimeMs) / 1000.0, 2),
    LastSeen = Timestamp
| order by LastSeen desc
