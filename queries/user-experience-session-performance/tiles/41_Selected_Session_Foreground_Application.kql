let StartTime=_startTime;
let EndTime=_endTime;
let UserFilter=tostring(_user);
let HostFilter=tostring(_host);
let SessionFilter=tostring(_session);
let AppMapping=Application_AppNameIdMapping
| where Timestamp between (StartTime-7d .. EndTime)
| summarize arg_max(Timestamp,AppName) by Host,AppId
| project Host,AppId,AppName;
Session_SessionDetail
| where Timestamp between (StartTime .. EndTime)
| extend User=tolower(SessionUser),SessionKey=iff(isnotempty(tostring(SessionGUID)),tostring(SessionGUID),strcat(Host,"|",tostring(SessionID))),AppId=SessionFgAppId
| where isempty(UserFilter) or User =~ UserFilter
| where isempty(HostFilter) or Host =~ HostFilter
| where isempty(SessionFilter) or SessionKey == SessionFilter
| join kind=leftouter AppMapping on Host,AppId
| extend Application=coalesce(AppName,AppId,SessionFgProcessName,"Unknown")
| summarize Samples=count(),FirstSeen=min(Timestamp),LastSeen=max(Timestamp),ProcessName=take_any(SessionFgProcessName),WindowTitle=take_any(SessionFgWindowTitle),AppVersion=take_any(SessionFgAppVersion),BrowserHost=take_any(SessionFgBrowserActiveTabHost),BrowserType=take_any(SessionFgBrowserType) by User,Host,SessionKey,SessionID,Application
| order by Samples desc
