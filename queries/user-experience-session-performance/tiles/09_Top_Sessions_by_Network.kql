let StartTime=_startTime;
let EndTime=_endTime;
let UserFilter=tostring(_user);
let HostFilter=tostring(_host);
let SessionFilter=tostring(_session);
let ProtocolFilter=tostring(_protocol);
let StateFilter=tostring(_connectionState);
let TopN=10;
Session_SessionDetail
| where Timestamp between (StartTime .. EndTime)
| extend User=tolower(SessionUser),SessionKey=iff(isnotnull(SessionGUID),tostring(SessionGUID),strcat(Host,"|",tostring(SessionID)))
| where isempty(UserFilter) or User =~ UserFilter
| where isempty(HostFilter) or Host =~ HostFilter
| where isempty(SessionFilter) or SessionKey == SessionFilter
| where isempty(ProtocolFilter) or SessionProtocol =~ ProtocolFilter
| where isempty(StateFilter) or SessionConnectionState =~ StateFilter
| summarize AvgNetworkKBPS=round(avg(SessionNetKBPS),2),PeakNetworkKBPS=round(max(SessionNetKBPS),2),AvgRTTMs=round(avg(toreal(SessionRoundTripTimeMs)),2),P95RTTMs=round(percentile(toreal(SessionRoundTripTimeMs),95),2),LastSeen=max(Timestamp),User=take_any(User),Host=take_any(Host),SessionID=take_any(SessionID),Protocol=take_any(SessionProtocol),Transport=take_any(SessionTransportProtocols),ConnectionState=take_any(SessionConnectionState) by SessionKey
| top TopN by PeakNetworkKBPS desc
| project User,Host,SessionKey,SessionID,Protocol,Transport,ConnectionState,AvgNetworkKBPS,PeakNetworkKBPS,AvgRTTMs,P95RTTMs,LastSeen
