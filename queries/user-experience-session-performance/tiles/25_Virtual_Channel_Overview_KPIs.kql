let StartTime=_startTime;
let EndTime=_endTime;
let UserFilter=tostring(_user);
let HostFilter=tostring(_host);
let SessionFilter=tostring(_session);
let VirtualChannelFilter=tostring(_virtualChannel);
let VirtualChannelBase=materialize(CitrixSession_VirtualChannelDetail
| where Timestamp between (StartTime .. EndTime)
| extend User=tolower(SessionUser),SessionKey=tostring(SessionGUID)
| where isempty(UserFilter) or User =~ UserFilter
| where isempty(HostFilter) or Host =~ HostFilter
| where isempty(SessionFilter) or SessionKey == SessionFilter
| where isempty(VirtualChannelFilter) or VirtualChannelVendorName =~ VirtualChannelFilter
| project Timestamp,SessionKey,User,Host,VirtualChannel=VirtualChannelVendorName,InputMB=VirtualChannelDataVolumeInputMB,OutputMB=VirtualChannelDataVolumeOutputMB);
VirtualChannelBase
| summarize Samples=count(),Sessions=dcount(SessionKey),Users=dcountif(User,isnotempty(User)),Hosts=dcountif(Host,isnotempty(Host)),VirtualChannels=dcountif(VirtualChannel,isnotempty(VirtualChannel)),InputMB=round(sum(InputMB),2),OutputMB=round(sum(OutputMB),2),OldestSample=min(Timestamp),NewestSample=max(Timestamp)
| extend TotalMB=round(InputMB+OutputMB,2),AvgMBPerSession=round((InputMB+OutputMB)/iff(Sessions==0,1.0,toreal(Sessions)),2),DataStatus=iff(Samples==0,"No data","Data available")
| project Samples,Sessions,Users,Hosts,VirtualChannels,InputMB,OutputMB,TotalMB,AvgMBPerSession,OldestSample,NewestSample,DataStatus
