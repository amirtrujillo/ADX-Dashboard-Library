let StartTime=_startTime;
let EndTime=_endTime;
let UserFilter=tostring(_user);
let HostFilter=tostring(_host);
let SessionFilter=tostring(_session);
let ProtocolFilter=tostring(_protocol);
let StateFilter=tostring(_connectionState);
let TopN=100;
Session_SessionDetail
| where Timestamp between (StartTime .. EndTime)
| extend User=tolower(SessionUser),SessionKey=iff(isnotnull(SessionGUID),tostring(SessionGUID),strcat(Host,"|",tostring(SessionID)))
| where isempty(UserFilter) or User =~ UserFilter
| where isempty(HostFilter) or Host =~ HostFilter
| where isempty(SessionFilter) or SessionKey == SessionFilter
| where isempty(ProtocolFilter) or SessionProtocol =~ ProtocolFilter
| where isempty(StateFilter) or SessionConnectionState =~ StateFilter
| summarize arg_max(Timestamp,*) by SessionKey
| extend SessionLogonDateTime=todatetime(SessionLogonTime),SessionDurationHours=iff(isnull(todatetime(SessionLogonTime)),real(null),round((Timestamp-todatetime(SessionLogonTime))/1h,2)),LastSeenAgeMinutes=round((EndTime-Timestamp)/1m,1),ConnectionPath=case(tolower(tostring(SessionBrokerTunneledVmw)) in ("true","1","yes") or isnotempty(SessionBrokerTunnelUrlVmw),"Gateway/Tunneled",SessionClientIp startswith "10." or SessionClientIp startswith "192.168." or SessionClientIp matches regex "^172\\.(1[6-9]|2[0-9]|3[0-1])\\.","Internal/Private","External/Unknown")
| project User,Host,SessionKey,SessionGUID,SessionID,ConnectionState=SessionConnectionState,Protocol=SessionProtocol,Transport=SessionTransportProtocols,ConnectionPath,ClientName=SessionClientName,ClientPlatform=SessionClientPlatform,ClientVersion=SessionClientVersion,PublishedResource=SessionPublishedName,ForegroundProcess=SessionFgProcessName,ForegroundWindow=SessionFgWindowTitle,SessionLogonDateTime,SessionDurationHours,CPUPercent=round(SessionCPUUsagePercent,2),WorkingSetMB=round(SessionWorkingSetMB,2),IOPS=round(SessionIOPS,2),NetworkKBPS=round(SessionNetKBPS,2),RTTMs=SessionRoundTripTimeMs,InputDelayMaxMs=SessionInputDelayMaxMs,FPS=SessionFps,LastSeen=Timestamp,LastSeenAgeMinutes
| top TopN by LastSeen desc
