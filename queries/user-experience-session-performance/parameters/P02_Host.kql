let StartTime=_startTime;
let EndTime=_endTime;
Session_SessionDetail
| where Timestamp between (StartTime .. EndTime)
| where isnotempty(Host)
| extend SessionKey=iff(isnotnull(SessionGUID),tostring(SessionGUID),strcat(Host,"|",tostring(SessionID)))
| summarize Sessions=dcount(SessionKey),Users=dcountif(tolower(SessionUser),isnotempty(SessionUser)),LastSeen=max(Timestamp) by Host
| extend Value=Host,Label=strcat(Host," (",tostring(Sessions)," sessions)")
| project Value,Label,Host,Sessions,Users,LastSeen
| order by Host asc
