let AppMap =
    Application_AppNameIdMapping
    | where Timestamp between (_startTime .. _endTime)
    | where isnotempty(AppId)
    | summarize arg_max(Timestamp, AppName) by Host, AppId
    | project Host, AppId, AppName;
let UIBase =
    Application_UIDelay
    | where Timestamp between (_startTime .. _endTime)
    | where Host in (_host) or isempty(_host)
    | where User in (_user) or isempty(_user)
    | where ProcessName in (_process) or isempty(_process)
    | join kind=leftouter AppMap on Host, AppId
    | extend Application = iff(isnotempty(AppName), AppName, ProcessName)
    | where isnotempty(Application)
    | where Application in (_application) or isempty(_application);
let Summary =
    UIBase
    | summarize
        UIEvents = count(),
        TotalUIDelaySeconds = round(sum(UIDelayMs) / 1000.0, 2),
        AverageUIDelayMs = round(avg(toreal(UIDelayMs)), 2),
        P95UIDelayMs = round(percentile(toreal(UIDelayMs), 95), 2),
        MaximumUIDelayMs = max(UIDelayMs),
        AffectedApplications = dcount(Application);
union
    (Summary | project Metric = "UI Events", MetricValue = todouble(UIEvents)),
    (Summary | project Metric = "Total UI Delay (s)", MetricValue = todouble(TotalUIDelaySeconds)),
    (Summary | project Metric = "Average UI Delay (ms)", MetricValue = todouble(AverageUIDelayMs)),
    (Summary | project Metric = "P95 UI Delay (ms)", MetricValue = todouble(P95UIDelayMs)),
    (Summary | project Metric = "Maximum UI Delay (ms)", MetricValue = todouble(MaximumUIDelayMs)),
    (Summary | project Metric = "Affected Applications", MetricValue = todouble(AffectedApplications))
