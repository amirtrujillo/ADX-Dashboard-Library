let TopN = tolong(_topN);
let NetworkBase =
    Process_NetworkTargetPerformance
    | where Timestamp between (_startTime .. _endTime)
    | where Host in (_host) or isempty(_host)
    | where ProcUser in (_user) or isempty(_user)
    | where ProcName in (_process) or isempty(_process)
    | extend Target = iff(
        isnotempty(NetTargetRemoteName),
        NetTargetRemoteName,
        tostring(NetTargetRemoteAddress)
    )
    | where isnotempty(Target);
NetworkBase
| summarize
    LatencyTotalMs = sum(NetTargetSendLatencyMs),
    LatencySamples = sum(NetTargetSendLatencyCount),
    Retransmits = sum(NetTargetRetransmitCount),
    Sends = sum(NetTargetSendCount),
    Hosts = dcount(Host),
    Users = dcountif(ProcUser, isnotempty(ProcUser)),
    Processes = dcountif(ProcName, isnotempty(ProcName))
    by Target
| extend
    AverageLatencyMs = iff(LatencySamples > 0, round(LatencyTotalMs / LatencySamples, 2), real(null)),
    PacketLossPercent = iff(Retransmits + Sends > 0, round(100.0 * Retransmits / (Retransmits + Sends), 2), real(null))
| where isnotnull(AverageLatencyMs)
| top TopN by AverageLatencyMs desc
| project Target, MetricValue = AverageLatencyMs, PacketLossPercent, Hosts, Users, Processes
