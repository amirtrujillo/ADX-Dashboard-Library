let VdaMachineRole = 0;
let RegisteredState = 1;
let Catalogs =
    Citrix_Catalogs
    | where Timestamp between (_startTime .. _endTime)
    | where SiteName in (_site) or isempty(_site)
    | where Name in (_catalog) or isempty(_catalog)
    | summarize arg_max(Timestamp, *) by Id
    | project
        CatalogId = Id,
        MachineCatalog = tostring(Name);
let MachineCounts =
    Citrix_Machines
    | where Timestamp between (_startTime .. _endTime)
    | where SiteName in (_site) or isempty(_site)
    | where CatalogDisplayName in (_catalog) or isempty(_catalog)
    | where DesktopGroupDisplayName in (_deliveryGroup) or isempty(_deliveryGroup)
    | where NameHost in (_host) or isempty(_host)
    | where isempty(_tag) or Tags contains _tag
    | summarize arg_max(Timestamp, *) by Id
    | summarize
        VDACount = countif(MachineRole == VdaMachineRole),
        RegisteredCount = countif(
            MachineRole == VdaMachineRole
            and CurrentRegistrationState == RegisteredState
        )
        by CatalogId;
Catalogs
| join kind=leftouter MachineCounts on CatalogId
| extend
    VDACount = coalesce(VDACount, 0),
    RegisteredCount = coalesce(RegisteredCount, 0)
| extend RegistrationPercent = todouble(
    iff(
        VDACount > 0,
        round(100.0 * RegisteredCount / VDACount, 1),
        real(null)
    )
)
| where isnotempty(MachineCatalog)
| project
    MachineCatalog = tostring(MachineCatalog),
    RegistrationPercent = todouble(RegistrationPercent)
| order by RegistrationPercent asc, MachineCatalog asc
